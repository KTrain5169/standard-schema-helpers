{
  "name": "@ktrain5369/standard-schema-helpers",
  "version": "0.0.0",
  "description": "A small set of utilities for working with Standard Schema validators.",
  "homepage": "https://github.com/KTrain5169/standard-schema-helpers#readme",
  "bugs": {
    "url": "https://github.com/KTrain5169/standard-schema-helpers/issues"
  },
  "license": "MIT",
  "author": {
    "name": "KTrain5369",
    "email": "me@ktrain5369.dev",
    "url": "https://ktrain5369.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KTrain5169/standard-schema-helpers.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./json": "./dist/json.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "deepmerge-ts": "^7.1.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.1.1",
    "@valibot/to-json-schema": "^1.7.1",
    "arktype": "^2.2.3",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.1.1",
      "onFail": "download"
    }
  }
}
